# ============================================================================
# HomeHub / IPTV Billing CRM — Environment Template (.env.example)
# ============================================================================

# --- Admin & Security Secrets ---
ADMIN_EMAILS="admin@example.com"
ADMIN_NAME="Адміністратор"
SESSION_SECRET="replace-with-32-byte-hex-hmac-secret"
CABINET_ENCRYPTION_KEY="replace-with-32-byte-aes256-gcm-secret"

# --- Firebase & Google OAuth Configuration ---
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_APP_ID="your-firebase-app-id"
FIREBASE_API_KEY="your-firebase-web-api-key"
FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
FIREBASE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_MEASUREMENT_ID=""
FIREBASE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
FIREBASE_RECAPTCHA_SITE_KEY=""

# --- Google Cloud SQL (PostgreSQL) ---
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME="cloud_sql_development_database"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
SQL_SSL="false"

# --- External PostgreSQL Database (Primary / Standby) ---
EXTERNAL_DATABASE_URL=""
EXTERNAL_DATABASE_HOST=""
EXTERNAL_DATABASE_PORT="5432"
EXTERNAL_DATABASE_USER=""
EXTERNAL_DATABASE_PASSWORD=""
EXTERNAL_DATABASE_NAME=""
EXTERNAL_DATABASE_SSL="true"

# --- DTEK Odesa Electric Grids (https://www.dtek-oem.com.ua) Cookies & CSRF ---
DTEK_METER_CSRF_TOKEN=""
DTEK_METER_COOKIES=""
DTEK_METER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:160.0) Gecko/20100101 Firefox/160.0"
DTEK_METER_BLOCK_ID="237"
DTEK_SCHEDULE_CSRF_TOKEN=""
DTEK_SCHEDULE_COOKIES=""

# --- OOEK Personal Cabinet (https://personal.ooek.od.ua) Fallback Session ---
OOEK_FALLBACK_AUTH_TOKEN=""
OOEK_FALLBACK_CSRF_TOKEN=""
OOEK_FALLBACK_SESSION_COOKIE=""

# --- Web Push Notifications (VAPID Keys) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@homehub.ai.studio"

# --- Telegram, Viber & Billing Requisites ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_SENDER_NAME=""
VIBER_AUTH_TOKEN=""
VIBER_SENDER_NAME=""
DEFAULT_CARD_REQUISITES=""

# --- Gemini AI API Key (Server-side only) ---
GEMINI_API_KEY=""
