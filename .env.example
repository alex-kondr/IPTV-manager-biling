# FIREBASE & FIRESTORE INTEGRATION
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_APP_ID="your_firebase_app_id"
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_firebase_project_id.firebaseapp.com"
FIREBASE_FIRESTORE_DATABASE_ID="your_firestore_database_id"
FIREBASE_STORAGE_BUCKET="your_firebase_project_id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
FIREBASE_MEASUREMENT_ID=""
FIREBASE_OAUTH_CLIENT_ID="your_oauth_client_id.apps.googleusercontent.com"
FIREBASE_RECAPTCHA_SITE_KEY=""

# GOOGLE OAUTH & WORKSPACE CLIENT
GOOGLE_CLIENT_ID="your_oauth_client_id.apps.googleusercontent.com"

# EXTERNAL DATABASE CONFIGURATION
EXTERNAL_DATABASE_URL="postgres://username:password@hostname:port/database?sslmode=require"
DATABASE_URL="postgres://username:password@hostname:port/database?sslmode=require"
EXTERNAL_DATABASE_HOST="hostname:port"
EXTERNAL_DATABASE_NAME="database_name"
# Set DB_SSL_CA (PEM) for strict cert verification, or leave empty for managed DB TLS
DB_SSL_REJECT_UNAUTHORIZED=""
DB_SSL_CA=""

# CLOUD SQL POSTGRESQL (If configured)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="cloud_sql_development_database"
SQL_SSL="false"

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="https://your-applet-domain.run.app"

# ACCESS CONTROL & DEFAULT BILLING REQUISITES
ADMIN_EMAILS="admin@example.com"
ADMIN_NAME="Адміністратор"
DEFAULT_CARD_REQUISITES=""

# UTILITY CABINET INTEGRATIONS (Keep secrets/cookies in .env, never in source code)
DTEK_METER_CSRF_TOKEN=""
DTEK_METER_COOKIES=""
DTEK_METER_USER_AGENT=""
OOEK_FALLBACK_AUTH_TOKEN=""
OOEK_FALLBACK_CSRF_TOKEN=""
OOEK_FALLBACK_SESSION_COOKIE=""

# SECURITY & ENCRYPTION
SESSION_SECRET="your_strong_random_hmac_session_secret"
CABINET_ENCRYPTION_KEY="your_strong_32char_encryption_key"
